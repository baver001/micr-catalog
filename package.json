{
  "name": "micr-fun-engine",
  "private": true,
  "version": "0.2.0",
  "description": "micr.fun — micro-app catalog (production codebase)",
  "scripts": {
    "link-cells": "powershell -ExecutionPolicy Bypass -File ./scripts/link-cells.ps1",
    "dev": "npm run link-cells && npx --yes serve . -l 8080 --no-port-switching",
    "dev:api": "cd server/api && npm install && node index.js",
    "deploy": "./infra/deploy.sh",
    "check:static": "node ./scripts/static-smoke.mjs",
    "check:i18n": "node ./scripts/i18n-check-keys.mjs",
    "check:deploy": "node ./scripts/deploy-config-check.mjs"
  }
}
